{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable"],
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"types": ["node"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["**/*.ts", "**/*.mjs"]
}
